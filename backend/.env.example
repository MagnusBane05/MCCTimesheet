# Copy this file to `.env` in the same directory and fill in real local values.
# Never commit the real `.env` (it is already gitignored via `*.env`).

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Confirmed: Eastern time (America/Toronto observes DST, unlike literal "EST").
DJANGO_TIME_ZONE=America/Toronto

# --- Database, consumed by Django (mysql-connector-python) ---
# DB_HOST=db matches the docker-compose service name; only correct when Django
# itself is also running inside docker-compose (see repository README).
DB_NAME=mcc_timesheet
DB_USER=mcc_timesheet
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# --- Consumed directly by the mysql:8 container in docker-compose.yml ---
# Keep these in sync with the DB_* values above.
MYSQL_DATABASE=mcc_timesheet
MYSQL_USER=mcc_timesheet
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- CORS: local Vite dev server origin(s), comma separated ---
# Not needed in production if React and Django share an origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- CSRF: needed locally too, since Vite (5173) and Django (8000) are
# different origins in dev even though production is same-origin ---
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Production security (leave all False/unset for local dev) ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# Only set True once BlackSun's proxy is confirmed to set X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_LOG_LEVEL=INFO
